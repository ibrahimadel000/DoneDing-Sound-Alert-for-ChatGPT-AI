{
  "manifest_version": 3,
  "name": "DoneDing",
  "version": "7.0.0",
  "description": "Multi-tab AI chat completion monitor with per-session sound selection, redesigned top-bar alerts, and computer system notifications.",
  "permissions": [
    "storage",
    "notifications",
    "offscreen",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.gemini.google.com/*",
    "*://gemini.google.com/*",
    "*://*.aistudio.google.com/*",
    "*://aistudio.google.com/*",
    "*://*.notebooklm.google.com/*",
    "*://notebooklm.google.com/*",
    "*://*.claude.ai/*",
    "*://claude.ai/*",
    "*://*.chatgpt.com/*",
    "*://chatgpt.com/*",
    "*://*.chat.openai.com/*",
    "*://chat.openai.com/*",
    "*://*.notion.com/*",
    "*://notion.com/*",
    "*://*.notion.so/*",
    "*://notion.so/*",
    "*://*.notion.site/*",
    "*://*.perplexity.ai/*",
    "*://perplexity.ai/*",
    "*://*.deepseek.com/*",
    "*://chat.deepseek.com/*",
    "*://*.copilot.microsoft.com/*",
    "*://copilot.microsoft.com/*",
    "*://*.m365.cloud.microsoft/*",
    "*://*.poe.com/*",
    "*://poe.com/*",
    "*://*.grok.com/*",
    "*://grok.com/*",
    "*://*.x.com/*",
    "*://x.com/*",
    "*://*.mistral.ai/*",
    "*://chat.mistral.ai/*",
    "*://*.qwen.ai/*",
    "*://chat.qwen.ai/*",
    "*://*.qwenlm.ai/*",
    "*://*.moonshot.cn/*",
    "*://kimi.moonshot.cn/*",
    "*://*.kimi.ai/*",
    "*://kimi.ai/*",
    "*://*.huggingface.co/*",
    "*://huggingface.co/*",
    "*://*.meta.ai/*",
    "*://meta.ai/*",
    "*://*.phind.com/*",
    "*://phind.com/*",
    "*://*.you.com/*",
    "*://you.com/*",
    "*://*.cohere.com/*",
    "*://coral.cohere.com/*",
    "*://*.v0.dev/*",
    "*://v0.dev/*",
    "*://*.bolt.new/*",
    "*://bolt.new/*",
    "*://*.lovable.dev/*",
    "*://lovable.dev/*",
    "*://*.replit.com/*",
    "*://replit.com/*",
    "*://*.character.ai/*",
    "*://character.ai/*",
    "*://*.pi.ai/*",
    "*://pi.ai/*",
    "*://*.duck.ai/*",
    "*://duck.ai/*",
    "*://*.blackbox.ai/*",
    "*://blackbox.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DoneDing \u2014 AI Chat Completion Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.gemini.google.com/*",
        "*://gemini.google.com/*",
        "*://*.aistudio.google.com/*",
        "*://aistudio.google.com/*",
        "*://*.notebooklm.google.com/*",
        "*://notebooklm.google.com/*",
        "*://*.claude.ai/*",
        "*://claude.ai/*",
        "*://*.chatgpt.com/*",
        "*://chatgpt.com/*",
        "*://*.chat.openai.com/*",
        "*://chat.openai.com/*",
        "*://*.notion.com/*",
        "*://notion.com/*",
        "*://*.notion.so/*",
        "*://notion.so/*",
        "*://*.notion.site/*",
        "*://*.perplexity.ai/*",
        "*://perplexity.ai/*",
        "*://*.deepseek.com/*",
        "*://chat.deepseek.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://copilot.microsoft.com/*",
        "*://*.m365.cloud.microsoft/*",
        "*://*.poe.com/*",
        "*://poe.com/*",
        "*://*.grok.com/*",
        "*://grok.com/*",
        "*://*.x.com/*",
        "*://x.com/*",
        "*://*.mistral.ai/*",
        "*://chat.mistral.ai/*",
        "*://*.qwen.ai/*",
        "*://chat.qwen.ai/*",
        "*://*.qwenlm.ai/*",
        "*://*.moonshot.cn/*",
        "*://kimi.moonshot.cn/*",
        "*://*.kimi.ai/*",
        "*://kimi.ai/*",
        "*://*.huggingface.co/*",
        "*://huggingface.co/*",
        "*://*.meta.ai/*",
        "*://meta.ai/*",
        "*://*.phind.com/*",
        "*://phind.com/*",
        "*://*.you.com/*",
        "*://you.com/*",
        "*://*.cohere.com/*",
        "*://coral.cohere.com/*",
        "*://*.v0.dev/*",
        "*://v0.dev/*",
        "*://*.bolt.new/*",
        "*://bolt.new/*",
        "*://*.lovable.dev/*",
        "*://lovable.dev/*",
        "*://*.replit.com/*",
        "*://replit.com/*",
        "*://*.character.ai/*",
        "*://character.ai/*",
        "*://*.pi.ai/*",
        "*://pi.ai/*",
        "*://*.duck.ai/*",
        "*://duck.ai/*",
        "*://*.blackbox.ai/*",
        "*://blackbox.ai/*"
      ],
      "js": [
        "sound_engine.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}